process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0

    withName: EXTRACT_LLM {
        cpus = 2
        memory = '8 GB'
        time = '6h'
    }

    withName: COMPARE_SYSTEMS {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm_client {
        process.executor = 'slurm'
        process.queue = 'small'
        process.clusterOptions = '--account=project_2012997'
    }
}
