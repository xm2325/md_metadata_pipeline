MDMETA_ENV=production
MDMETA_DATABASE_PATH=./data/records.sqlite
MDMETA_DATABASE_READ_ONLY=true
MDMETA_HOST=127.0.0.1
MDMETA_PORT=8000
MDMETA_WORKERS=1
MDMETA_LOG_LEVEL=info
MDMETA_ALLOWED_HOSTS=127.0.0.1,localhost
MDMETA_PROXY_HEADERS=true
MDMETA_FORWARDED_ALLOW_IPS=127.0.0.1
MDMETA_LIMIT_CONCURRENCY=100
MDMETA_BACKLOG=128
MDMETA_TIMEOUT_KEEP_ALIVE=5
MDMETA_TIMEOUT_GRACEFUL_SHUTDOWN=25
MDMETA_ENABLE_DOCS=false
MDMETA_DATASET_SHA256=REQUIRED_64_HEX_DATABASE_SHA256
MDMETA_BUILD_SHA=REQUIRED_GIT_COMMIT_SHA
MDMETA_IMAGE=ghcr.io/xm2325/md_metadata_pipeline@sha256:REQUIRED_IMAGE_DIGEST

# Optional offline LLM extraction client. Do not expose the model server through the public API.
MDMETA_LLM_BASE_URL=http://127.0.0.1:8000/v1
MDMETA_LLM_MODEL=Qwen/Qwen3.6-27B
MDMETA_LLM_API_KEY=
MDMETA_LLM_TIMEOUT_SECONDS=180
MDMETA_LLM_MAX_OUTPUT_TOKENS=4096
MDMETA_LLM_MAX_RETRIES=2
MDMETA_LLM_RETRY_BACKOFF_SECONDS=1
MDMETA_LLM_DISABLE_THINKING=true
MDMETA_LLM_SEED=0
