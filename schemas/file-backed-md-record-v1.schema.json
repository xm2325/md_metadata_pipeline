        },
        "assignment_method": {
          "title": "Assignment Method",
          "type": "string"
        },
        "identity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Identity",
          "type": "number"
        },
        "matches": {
          "title": "Matches",
          "type": "integer"
        },
        "md_chain_id": {
          "title": "Md Chain Id",
          "type": "string"
        },
        "md_insertions": {
          "title": "Md Insertions",
          "type": "integer"
        },
        "mismatches": {
          "title": "Mismatches",
          "type": "integer"
        },
        "pdb_chain_id": {
          "title": "Pdb Chain Id",
          "type": "string"
        },
        "pdb_deletions": {
          "title": "Pdb Deletions",
          "type": "integer"
        },
        "pdb_residue_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pdb Residue Coverage",
          "type": "number"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        }
      },
      "required": [
        "md_chain_id",
        "pdb_chain_id",
        "assignment_method",
        "assignment_ambiguous",
        "score",
        "matches",
        "mismatches",
        "md_insertions",
        "pdb_deletions",
        "pdb_residue_coverage",
        "identity"
      ],
      "title": "ChainAlignmentAudit",
      "type": "object"
    },
    "ConsistencyAudit": {
      "additionalProperties": false,
      "properties": {
        "atom_count_consistent": {
          "title": "Atom Count Consistent",
          "type": "boolean"
        },
        "atom_identity_match_count": {
          "title": "Atom Identity Match Count",
          "type": "integer"
        },
        "atom_identity_match_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Atom Identity Match Fraction",
          "type": "number"
        },
        "atom_identity_mismatch_count": {
          "title": "Atom Identity Mismatch Count",
          "type": "integer"
        },
        "coordinates_finite": {
          "title": "Coordinates Finite",
          "type": "boolean"
        },
        "expected_frame_count": {
          "title": "Expected Frame Count",
          "type": "integer"
        },
        "failures": {
          "items": {
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "observed_frame_count": {
          "title": "Observed Frame Count",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "residue_count_consistent": {
          "title": "Residue Count Consistent",
          "type": "boolean"
        },
        "segment_identity_match_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Segment Identity Match Fraction",
          "type": "number"
        }
      },
      "required": [
        "atom_count_consistent",
        "residue_count_consistent",
        "atom_identity_match_count",
        "atom_identity_mismatch_count",
        "atom_identity_match_fraction",
        "segment_identity_match_fraction",
        "coordinates_finite",
        "expected_frame_count",
        "observed_frame_count",
        "passed"
      ],
      "title": "ConsistencyAudit",
      "type": "object"
    },
    "FileHash": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "local_path": {
          "title": "Local Path",
          "type": "string"
        },
        "retrieval_command": {
          "title": "Retrieval Command",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "role",
        "filename",
        "source_uri",
        "local_path",
        "byte_size",
        "sha256",
        "retrieval_command"
      ],
